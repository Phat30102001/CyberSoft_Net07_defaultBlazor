@page "/signalr/counter"
@using Microsoft.AspNetCore.SignalR.Client

@inject NavigationManager navigation
@implements IAsyncDisposable
<PageTitle>SignalR Realtime Counter</PageTitle>

<div class="container py-4">
    <h1>Demo Realtime Counter</h1>
    <div class="alert @(connected ? "alert-success" : "alert-secondary")">
        Trạng thái : <b>@(connected ? "Connected" : "Disconnected")</b>
    </div>
    <section class="card p-4">
        <div class="display-4">@votes</div>
        <button class="btn btn-success mt-2" @onclick="Vote" disabled=@(!connected)>Vote</button>
        <small class="d-block mt-2">Mở hai trình duyệt, click một bên và quan sát bên còn lại.</small>
    </section>

</div>

@code {
    private HubConnection? hub;
    private bool connected = false;

    private int votes;
    @* private void Vote()
    {
        votes++;
    } *@
    private async Task Vote(){
        await hub.SendAsync("Vote");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender){
        if(!firstRender) return;
        // votehub là endpoint được cấu hình bằng MapHub trong program
        hub = new HubConnectionBuilder()
        .WithUrl((navigation.ToAbsoluteUri("/votehub"))).Build();
        // lắng nghe sự kiện VoteChanged , 
        hub.On<int>("VoteChanged", total=>{
            votes = total;
            InvokeAsync(StateHasChanged);
        });

        await hub.StartAsync();
        connected = true;

        StateHasChanged();
    }

    public async ValueTask DisposeAsync(){
        await hub.DisposeAsync();
    }
}
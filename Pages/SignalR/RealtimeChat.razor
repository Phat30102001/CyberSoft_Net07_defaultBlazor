@page "/signalr/chat"
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject NavigationManager navigation

<PageTitle>Chat Room Mini</PageTitle>

<div class="container py-4">
    <h1>Bài tập 2: Chat Room Mini</h1>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="badge @(connected ? "bg-success" : "bg-secondary")">
            @(connected ? "Connected" : "Disconnected")
        </span>
        <span>🟢 Online: <strong>@online</strong></span>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label">Tên</label>
            <input class="form-control" @bind="userName" />
        </div>
        <div class="col-md-8">
            <label class="form-label">Tin nhắn</label>
            <div class="input-group">
                <input class="form-control" @bind="message" @bind:event="oninput"
                       placeholder="Nhập tin nhắn và Enter" />
                <button class="btn btn-primary" disabled="@(!connected)" @onclick="Send">Gửi</button>
            </div>
        </div>
    </div>

    <div class="chat-box">
        @if (messages.Count == 0)
        {
            <p class="text-muted text-center">Chưa có tin nhắn. Hãy mở thêm một cửa sổ trình duyệt.</p>
        }
        @foreach (var item in messages)
        {
            <div class="chat-message">
                <strong>@item.User</strong>
                <small>@item.Time</small>
                <div>@item.Text</div>
            </div>
        }
    </div>
</div>

@code {

    private HubConnection hub;
    private int online;
    private bool connected = false;
    private string userName = "User-" + Random.Shared.Next(100, 999);
    private string message;
    private List<ChatItem> messages = [
@* new ChatItem("GV", "Hello", "10:00"),
    new ChatItem("HV1", "hi", "10:03"),
    new ChatItem("HV2", "2", "10:05"),
    new ChatItem("HV3", "bye", "10:03"), *@
        ];


    private record ChatItem(string User, string Text, string Time);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        hub = new HubConnectionBuilder().WithUrl(navigation.ToAbsoluteUri("/chathub")).Build();

        // lắng nghe sk OnlineChanged
        hub.On<int>("OnlineChanged", onlineCount =>
        {
            online = onlineCount;
            InvokeAsync(StateHasChanged);
        });

        // lắng nghe RecieveMessage
        hub.On<string, string, string>("RecieveMessage", RecieveMessage);

        // start
        await hub.StartAsync();

        // tham gia chat
        await hub.SendAsync("Join", userName);
        connected = true;
        StateHasChanged();

    }
    private void RecieveMessage(string username, string mess, string time)
    {
        messages.Add(new ChatItem(username, mess, time));
        InvokeAsync(StateHasChanged);
    }

    private async Task Send(){
        await hub.SendAsync("SendMessage",userName, message);
    }
    public async ValueTask DisposeAsync()
    {
        await hub.DisposeAsync();
    }

}
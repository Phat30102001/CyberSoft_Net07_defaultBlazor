<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        @* neu tim duoc @page tuong ung thi *@
        <Found Context="routeData">
            @* routerview : render componen khớp với @page *@
            @* <RouteView DefaultLayout="typeof(MainLayout)" RouteData="@routeData" /> *@
            @* thay routerview thành author view *@
            <AuthorizeRouteView DefaultLayout="typeof(MainLayout)" RouteData="@routeData">
                <Authorizing>
                    <p class="alert alert-info m-4">Đang kiểm tra trạng thái đăng nhập...</p>
                </Authorizing>
                <NotAuthorized>
                    @* Người dùng chưa đăng nhập / chưa có token hợp lệ thì sẽ đi vào nhánh này *@
                    <div class="alert alert-danger m-4">
                        Bạn chưa đăng nhập hoặc không có quyền truy cập.
                        <a href="/auth/login">Đi đến trang đăng nhập</a>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        @* neeu khong tim duoc @page tuong ung thi hien thi phan notfound *@
        <NotFound>
            <p>Xin lỗi , trang không tồn tại</p>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
